{
  "name": "solo-map",
  "version": "1.0.0",
  "description": "혼밥 난이도 지도 - 식당별 혼밥 난이도 및 리뷰 공유 서비스",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node -e \"const fs = require('fs'); if(fs.existsSync('src/data')) fs.cpSync('src/data', 'dist/data', {recursive: true});\"",
    "start": "node dist/app.js",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "reset": "prisma migrate reset --force && prisma db seed",
    "test": "tsx --test scripts/test_db_errors.ts scripts/test_production.ts",
    "test:ui": "node scripts/test_account_ui.cjs",
    "test:api": "tsx scripts/verify_api.ts"
  },
  "keywords": [
    "solo-map",
    "express5",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@prisma/client": "7.10.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-session": "^1.19.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "typescript": "^5.8.2",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "prisma": "7.10.1",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.19.3",
    "@types/pg": "8.15.5"
  },
  "engines": {
    "node": "24.x"
  }
}
