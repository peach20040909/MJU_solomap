# 혼밥지도(SoloMap) 평가용 요청 파일
# 실행 전: npm run reset → npm run dev, 그다음 01번부터 마지막까지 순서대로 실행한다.
# 시드 사용자 A·B는 prisma/seed.ts가 학교 메일 인증 완료 상태로 넣는 테스트 계정이다.
# 로그인 이후 요청은 REST Client가 세션 쿠키(connect.sid)를 자동으로 보낸다.

@baseUrl = http://localhost:3000
@seedPassword = seedpass1234
@emailA = seed-a@mju.ac.kr
@emailB = seed-b@mju.ac.kr
@newEmail = seed-new@mju.ac.kr
@newPassword = newpass1234
# 시드된 식당 2곳 (src/data/daedongPlaces.json)
@placeA = 16418234
@placeB = 13287579

### 01. 회원가입(시드에 없는 새 사용자) → 201
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "password": "{{newPassword}}",
  "nickname": "새학우"
}

### 02. 사용자 A 로그인(시드 사용자) → 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{emailA}}",
  "password": "{{seedPassword}}"
}

### 03. 리뷰 등록(주요 데이터) → 201
# @name createReview
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "placeId": "{{placeA}}",
  "soloLevel": 2,
  "content": "1인석이 있어서 혼자 먹기 편해요."
}

### 04. 필수 값(content)이 빠진 리뷰 등록 → 400
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "placeId": "{{placeA}}",
  "soloLevel": 2
}

### 05. 식당별 리뷰 목록 조회 → 200
GET {{baseUrl}}/api/reviews/place/{{placeA}}

### 06. 식당 검색·필터 조회(키워드 + 혼밥 난이도 2) → 200
GET {{baseUrl}}/api/places?query=치즈&soloLevel=2

### 07. 리뷰 상세 조회 → 200
GET {{baseUrl}}/api/reviews/{{createReview.response.body.review.id}}

### 08. 없는 id로 리뷰 상세 조회 → 404
GET {{baseUrl}}/api/reviews/no-such-review-id

### 09. 사용자 A의 리뷰 수정 → 200
PATCH {{baseUrl}}/api/reviews/{{createReview.response.body.review.id}}
Content-Type: application/json

{
  "soloLevel": 1,
  "content": "다시 가 보니 키오스크라 더 편했어요."
}

### 10. 사용자 B 로그인(시드 사용자) → 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{emailB}}",
  "password": "{{seedPassword}}"
}

### 11. 사용자 B가 사용자 A의 리뷰 수정 → 403
PATCH {{baseUrl}}/api/reviews/{{createReview.response.body.review.id}}
Content-Type: application/json

{
  "soloLevel": 5,
  "content": "남의 리뷰 수정 시도"
}

### 12. 사용자 A 다시 로그인 → 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{emailA}}",
  "password": "{{seedPassword}}"
}

### 13. 사용자 A의 리뷰 삭제 → 204
DELETE {{baseUrl}}/api/reviews/{{createReview.response.body.review.id}}

### 14. 로그아웃 → 204
POST {{baseUrl}}/api/auth/logout

### 15. 로그아웃 상태에서 리뷰 등록 → 401
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "placeId": "{{placeA}}",
  "soloLevel": 2,
  "content": "로그인 없이 작성 시도"
}

# ---------------------------------------------------------------
# 고유 기능 1. 혼밥 체크인과 레벨 성장
#  - 식당 방문 체크인으로 경험치를 얻고 레벨이 오른다.
#  - 같은 식당은 하루(KST) 한 번만 체크인할 수 있다(409). 없는 식당은 404.
# ---------------------------------------------------------------

### 16. 사용자 A 로그인 → 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{emailA}}",
  "password": "{{seedPassword}}"
}

### 17. 식당 체크인(다녀왔어요) → 201
POST {{baseUrl}}/api/places/{{placeB}}/checkins

### 18. 같은 날 같은 식당 다시 체크인 → 409
POST {{baseUrl}}/api/places/{{placeB}}/checkins

### 19. 없는 식당 체크인 → 404
POST {{baseUrl}}/api/places/no-such-place/checkins

### 20. 내 레벨·경험치 조회(체크인 반영) → 200
GET {{baseUrl}}/api/users/me/level

### 21. 내 레벨에 맞는 다음 도전 식당 추천 → 200
GET {{baseUrl}}/api/users/me/recommendations

# ---------------------------------------------------------------
# 고유 기능 2. 학우 리뷰로 혼밥 난이도 재계산
#  - 리뷰가 있으면 식당 난이도를 리뷰 평균(반올림)으로 바꾸고 "(학우평가)"를 붙인다.
#  - 난이도는 1~5 정수만 허용(400).
# ---------------------------------------------------------------

### 22. 난이도 범위를 벗어난 리뷰 등록 → 400
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "placeId": "{{placeB}}",
  "soloLevel": 9,
  "content": "난이도 범위 오류 확인"
}

### 23. 난이도 5로 리뷰 등록 → 201
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "placeId": "{{placeB}}",
  "soloLevel": 5,
  "content": "점심엔 단체 손님이 많아 혼자 앉기 어려웠어요."
}

### 24. 식당 상세에서 학우평가 난이도 확인(displaySolo.isStudentEvaluated = true) → 200
GET {{baseUrl}}/api/places/{{placeB}}

### 25. 같은 식당에 두 번째 리뷰 등록(1인 1리뷰) → 409
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "placeId": "{{placeB}}",
  "soloLevel": 3,
  "content": "중복 리뷰 시도"
}

# ---------------------------------------------------------------
# 고유 기능 3. 명지대 학교 메일 인증
#  - @mju.ac.kr 주소만 가입할 수 있다(400).
#  - 학교 메일 인증 전에는 리뷰·체크인을 할 수 없다(403). 틀린 인증 코드는 400.
# ---------------------------------------------------------------

### 26. 학교 메일이 아닌 주소로 회원가입 → 400
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "email": "someone@gmail.com",
  "password": "{{newPassword}}",
  "nickname": "외부사용자"
}

### 27. 01에서 가입한 새 사용자 로그인(인증 전) → 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{newEmail}}",
  "password": "{{newPassword}}"
}

### 28. 학교 메일 인증 전 리뷰 등록 → 403
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "placeId": "{{placeA}}",
  "soloLevel": 2,
  "content": "인증 전 작성 시도"
}

### 29. 학교 메일 인증 전 체크인 → 403
POST {{baseUrl}}/api/places/{{placeA}}/checkins

### 30. 틀린 인증 코드 입력 → 400
POST {{baseUrl}}/api/auth/verify
Content-Type: application/json

{
  "code": "000000"
}

### 31. 로그아웃 → 204
POST {{baseUrl}}/api/auth/logout
