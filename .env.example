# 서버 포트 번호
PORT=3000
NODE_ENV=development

# 카카오 개발자 콘솔(https://developers.kakao.com)에서 발급받은 'REST API 키'
# 사용 방법: 이 파일을 복사해서 '.env' 파일을 만든 후 실제 발급받은 키를 아래에 적어주세요.
KAKAO_REST_API_KEY=
GEMINI_API_KEY=
NAVER_CLIENT_ID=

# [데이터베이스] Supabase PostgreSQL 접속 URL (Prisma 연동)
# 트랜잭션 풀러 URL (pgbouncer=true 포함, 포트 6543)
DATABASE_URL=

# 직접 접속 URL (마이그레이션용 Direct Connection, 포트 5432)
DIRECT_URL=

# [세션 보안 키] 개발 기본값이 아닌 32자 이상의 임의 값
SESSION_SECRET=

# [학교 메일 인증 SMTP] SMTP 미설정 콘솔 코드는 로컬 개발에서만 허용. 운영/Preview에서는 아래 설정 필수.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
